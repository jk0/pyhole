# Global Configuration

[Pyhole]
admins = nick!ident, nick2!ident
command_prefix = .
reconnect_delay = 60
rejoin_delay = 5
debug = False
plugins = admin, weather, stocks, search, urls, kernel
networks = Libera

[Libera]
server = irc.libera.chat
username =
password =
port = 6697
ssl = True
ssl_verify = True
nick = mynick
identify_password =
channels = #mychannel, #mychannel2
