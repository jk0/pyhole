# Global Configuration

[Pyhole]
admins = nick!ident, nick2!ident, slack.username
command_prefix = .
reconnect_delay = 60
rejoin_delay = 5
debug = False
api_enabled = False
api_host = 127.0.0.1
api_port = 5000
# Optional bearer token for POST /pastes, /messages/send, and PagerDuty pages.
# api_auth_token = change-me
# api_ssl_crt = /home/ubuntu/.pyhole/ssl.crt
# api_ssl_key = /home/ubuntu/.pyhole/ssl.key
plugins = admin, weather, stocks, search, urls, kernel
networks = FreeNode, SlackNetwork

[GoogleMaps]
# Optional. Used by the distance plugin.
# key = abcd1234

[Jira]
# Optional. Leave commented to skip the plugin.
# auth_server = https://auth.jira.example.com
# domain = https://jira.example.com
# username = abcd1234
# password = pass1234
# verify_ssl = True

[PagerDuty]
# Optional.
# api_token = abcd1234

[Redmine]
# Optional.
# domain = redmine.example.com
# key = abcd1234

[TMDB]
# Optional. Used by the boxoffice plugin.
# key = abcd1234

[XSA]
notify = #channel1, #channel2

# Network Configuration

[FreeNode]
server = irc.libera.chat
username =
password =
port = 6697
ssl = True
ssl_verify = True
ipv6 = False
bind_to =
nick = mynick
identify_password =
channels = #mychannel, #mychannel2

[SlackNetwork]
# Bot token (xoxb-...) and app-level token (xapp-...) for Socket Mode.
api_token = xoxb-abcd1234
app_token = xapp-abcd1234
nick = mynick
